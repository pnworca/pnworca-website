<div style="flex: none; width: 76px; height: 60px; border-radius: 10px; background: #FFFFFF; border: 1px solid #E1E7EC; display: flex; align-items: center; justify-content: center; padding: 4px; box-sizing: border-box"><img src="{{ c.logo }}" alt="" aria-hidden="true" style="max-width: 100%; max-height: 100%; object-fit: contain; display: block"></div>
