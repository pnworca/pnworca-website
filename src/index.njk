{% for s in home.states %}
<a href="#{{ s.id }}" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; box-sizing: border-box; padding: 10px 20px; background: #221D35; border-radius: 9999px; color: #FFFFFF; text-decoration: none; font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: 0.08em">{{ s.name }}<span style="background: #F36D21; color: #221D35; font-size: 13px; padding: 2px 9px; border-radius: 9999px">{{ s.count }}</span></a>
