{% if c.noLogo %}
<div style="flex: none; width: 76px; height: 60px; border-radius: 10px; background: #221D35; display: flex; align-items: center; justify-content: center"><svg viewBox="0 0 216 63" width="54" height="16" aria-hidden="true"><path fill="#F36D21" d="{{ home.orca }}"></path></svg></div>
