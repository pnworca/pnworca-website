---
layout: layouts/base.njk
---
{% from "macros.njk" import divider, crumbs as crumbnav, eyebrow with context %}
<section style="position: relative; background: #1E2427; color: #FFFFFF; overflow: hidden">
<div class="wrap" style="position: relative; z-index: 1; padding-top: 40px; padding-bottom: 150px; display: flex; flex-direction: column; gap: 22px">
{{ crumbnav(crumbs) }}
{% if sections[section] and sections[section].url != page.url %}<div style="font-size: 13px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #FDB714">{{ sections[section].title }}</div>{% endif %}
<h1 class="cond page-h1" style="margin: 0; line-height: 0.9; max-width: 900px">{{ title }}</h1>
</div>
{{ divider('#FFFFFF', line='#F36D21', overlay=true) }}
</section>

<section style="background: #FFFFFF">
<div class="wrap" style="padding-top: 32px; padding-bottom: 96px">
<div class="cols">
<div class="prose longform" style="font-size: 18px; min-width: 0">
{{ content | safe }}
</div>
{% if siblings.length > 1 %}
<aside class="aside" aria-label="{{ sections[section].title }} pages" style="background: #F6F5F5; border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 14px">
<h2 class="cond" style="margin: 0; font-size: 26px; color: #1E2427">{{ sections[section].title }}</h2>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 16px">
{% for s in siblings %}<li>{% if s.url == page.url %}<span aria-current="page" style="font-weight: 700">{{ s.title }}</span>{% else %}<a href="{{ s.url }}">{{ s.title }}</a>{% endif %}</li>
{% endfor %}</ul>
</aside>
{% endif %}
</div>
</div>
{{ divider('#1E2427', fin=true) }}
</section>
