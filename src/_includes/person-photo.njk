{%- if p.photo %}<img src="{{ p.photo }}" alt="{{ p.name }}" style="width: {{ size }}px; height: {{ size }}px; border-radius: 9999px; object-fit: cover; display: block; flex: none">{% else %}<div aria-hidden="true" style="width: {{ size }}px; height: {{ size }}px; border-radius: 9999px; background: #221D35; display: flex; align-items: center; justify-content: center; flex: none"><svg viewBox="0 0 216 63" width="{{ size * 0.6 }}" height="{{ size * 0.18 }}"><path fill="#F36D21" d="{{ home.orca }}"></path></svg></div>{% endif -%}
