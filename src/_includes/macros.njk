{% macro divider(fill, fin=false, line=false, overlay=false) -%}
<div aria-hidden="true" style="{% if overlay %}position: absolute; left: 0; bottom: -1px; width: 100%; height: 130px; z-index: 2; overflow: hidden{% else %}position: relative; height: 130px; overflow: hidden{% endif %}">
{%- if line %}<svg class="drift-r" width="4320" height="130" viewBox="0 0 4320 130" style="position: absolute; left: 0; bottom: 0; display: block">{% for k in [0,1,2] %}<path fill="none" stroke="{{ line }}" stroke-width="3" transform="translate({{ k * 1440 }} 0)" d="{{ home.waveLine }}"></path>{% endfor %}</svg>{% endif -%}
<svg class="drift" width="4320" height="130" viewBox="0 0 4320 130" style="position: absolute; left: 0; bottom: 0; display: block">{% for k in [0,1,2] %}<path fill="{{ fill }}" transform="translate({{ k * 1440 }} 0)" d="{{ home.wavePlain }}"></path>{% if fin %}<path fill="{{ fill }}" transform="translate({{ k * 1440 }} 0)" d="{{ home.fin }}"></path>{% endif %}{% endfor %}</svg>
</div>
{%- endmacro %}

{% macro crumbs(items) -%}
<nav class="crumbs" aria-label="Breadcrumb"><ol>
{%- for it in items %}{% if loop.last %}<li><span aria-current="page" style="color: #FFFFFF">{{ it[0] }}</span></li>{% else %}<li><a href="{{ it[1] }}" style="color: #FDB714; text-decoration: none">{{ it[0] }}</a></li>{% endif %}{% endfor -%}
</ol></nav>
{%- endmacro %}

{% macro faq(items) -%}
<div class="faq">{% for q in items %}<details><summary>{{ q[0] }}</summary><p style="margin: 10px 0 0; color: #4A4458; max-width: 68ch">{{ q[1] }}</p></details>{% endfor %}</div>
{%- endmacro %}

{% macro eyebrow(text, color="#283485", size=13) -%}
<div style="font-size: {{ size }}px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: {{ color }}">{{ text }}</div>
{%- endmacro %}

{% macro arrow() -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>{%- endmacro %}

{% macro pin() -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>{%- endmacro %}

{% macro logoTile(c, bg="#FFFFFF") -%}
<div style="flex: none; width: 76px; height: 60px; border-radius: 10px; background: {{ bg }}; border: 1px solid #E1E7EC; display: flex; align-items: center; justify-content: center; padding: 4px; box-sizing: border-box">
{%- if c.logo %}<img src="{{ c.logo }}" alt="" aria-hidden="true" style="max-width: 100%; max-height: 100%; object-fit: contain; display: block">{% else %}<svg viewBox="0 0 216 63" width="54" height="16" aria-hidden="true"><path fill="#F36D21" d="{{ home.orca }}"></path></svg>{% endif -%}
</div>
{%- endmacro %}
