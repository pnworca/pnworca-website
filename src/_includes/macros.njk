{% macro divider(fill, fin=false, line=false, overlay=false) -%}
<div aria-hidden="true" style="{% if overlay %}position: absolute; left: 0; bottom: -1px; width: 100%; height: 130px; z-index: 2; overflow: hidden{% else %}position: relative; height: 130px; overflow: hidden{% endif %}">
{%- if line %}<svg class="drift-r" width="4320" height="130" viewBox="0 0 4320 130" style="position: absolute; left: 0; bottom: 0; display: block">{% for k in [0,1,2] %}<path fill="none" stroke="{{ line }}" stroke-width="3" transform="translate({{ k * 1440 }} 0)" d="{{ home.waveLine }}"></path>{% endfor %}</svg>{% endif -%}
<svg class="drift" width="4320" height="130" viewBox="0 0 4320 130" style="position: absolute; left: 0; bottom: 0; display: block">{% for k in [0,1,2] %}<path fill="{{ fill }}" transform="translate({{ k * 1440 }} 0)" d="{{ home.wavePlain }}"></path>{% if fin %}<path fill="{{ fill }}" transform="translate({{ k * 1440 }} 0)" d="{{ home.fin }}"></path>{% endif %}{% endfor %}</svg>
</div>
{%- endmacro %}

{% macro crumbs(items) -%}
<nav class="crumbs" aria-label="Breadcrumb"><ol>
{%- for it in items %}{% if loop.last %}<li><span aria-current="page" style="color: #FFFFFF">{{ it[0] }}</span></li>{% else %}<li><a href="{{ it[1] }}" style="color: #FDB714; text-decoration: none">{{ it[0] }}</a></li>{% endif %}{% endfor -%}
</ol></nav>
{%- endmacro %}

{% macro faq(items) -%}
<div class="faq">{% for q in items %}<details><summary>{{ q[0] }}</summary><p style="margin: 10px 0 0; color: #4A4458; max-width: 68ch">{{ q[1] }}</p></details>{% endfor %}</div>
{%- endmacro %}

{% macro eyebrow(text, color="#283485", size=13) -%}
<div style="font-size: {{ size }}px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: {{ color }}">{{ text }}</div>
{%- endmacro %}

{% macro arrow() -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>{%- endmacro %}

{% macro pin() -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>{%- endmacro %}

{% macro logoTile(c, bg="#FFFFFF") -%}
<div style="flex: none; width: 76px; height: 60px; border-radius: 10px; background: {{ bg }}; border: 1px solid #E1E7EC; display: flex; align-items: center; justify-content: center; padding: 4px; box-sizing: border-box">
{%- if c.logo %}<img src="{{ c.logo }}" srcset="{{ c.logo | logoSrcset }}" width="{{ c.logo | imgW }}" height="{{ c.logo | imgH }}" loading="lazy" alt="" aria-hidden="true" style="width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; display: block">{% else %}<svg viewBox="{{ home.markViewBox }}" width="30" height="28" aria-hidden="true"><path fill="#283485" d="{{ home.mark }}"></path></svg>{% endif -%}
</div>
{%- endmacro %}

{# Race row used on the home page, the race calendar and race-type pages. data-end lets races.js drop a race once it is over. #}
{% macro raceCard(r, hidden=false, summary=false) -%}
<a class="race-row" href="/events/{{ r.slug }}/" data-end="{{ r.date | isoLocal('23:59') }}" data-name="{{ r.name }}" data-callout="{{ r.callout }}" data-when="{{ r.date | dayShort }}{% if r.dateStatus == 'draft' %} (draft date){% endif %} · {% if r.venue %}{{ r.venue.city }}, {{ r.venue.region }}{% else %}{{ r.where }}{% endif %}"{% if hidden %} hidden{% endif %} style="display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; padding: 18px; border: 1px solid #E1E7EC; border-radius: 16px; text-decoration: none; color: #221D35; background: #FFFFFF">
<div style="flex: none; width: 92px; height: 92px; border-radius: 12px; background: #F36D21; color: #221D35; display: flex; flex-direction: column; align-items: center; justify-content: center">
<div class="cond" style="font-size: 44px; line-height: 0.9">{{ r.date | dayNum }}</div>
<div style="font-size: 13px; font-weight: 700; letter-spacing: 0.14em">{{ r.date | monShort }}</div>
</div>
<div style="flex: 999 1 240px; display: flex; flex-direction: column; gap: 6px; min-width: 0">
<div style="font-size: 13px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #283485">{{ r.callout }}</div>
<div class="cond" style="font-size: 30px; line-height: 1; color: #1E2427">{{ r.name }}</div>
{% if summary and r.summary %}<p style="margin: 2px 0 0; font-size: 16px; line-height: 1.45; color: #4A4458; max-width: 72ch">{{ r.summary }}</p>{% endif %}
<div style="display: flex; flex-wrap: wrap; gap: 6px 18px; color: #626A70; font-size: 15px">
<span style="display: inline-flex; align-items: center; gap: 6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#283485" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>{% if r.venue %}{{ r.venue.name }}, {{ r.venue.city }}, {{ r.venue.region }}{% else %}{{ r.where }}{% endif %}</span>
<span style="display: inline-flex; align-items: center; gap: 6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#283485" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 11a3 3 0 1 0 0-6M18 20c0-2.5-1-4.4-2.5-5.4"></path></svg>Hosted by {{ r.host or "Host to be announced" }}</span>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px">
<span class="race-ended" style="display: none; background: #CCD5DB; color: #221D35; font-size: 13px; font-weight: 800; padding: 7px 14px; border-radius: 9999px; letter-spacing: 0.06em; text-transform: uppercase">Ended</span>
{% if r.dateStatus == "draft" %}<div style="background: #FDB714; color: #221D35; font-size: 13px; font-weight: 700; padding: 7px 14px; border-radius: 9999px; letter-spacing: 0.06em">Draft date</div>{% endif %}
<div style="background: #E1E7EC; color: #221D35; font-size: 13px; font-weight: 700; padding: 7px 14px; border-radius: 9999px; letter-spacing: 0.06em">{{ r.classes or r.category }}</div>
<div style="width: 44px; height: 44px; border-radius: 9999px; background: #221D35; color: #FFFFFF; display: flex; align-items: center; justify-content: center">{{ arrow() }}</div>
</div>
</a>
{%- endmacro %}

{# Club card used on the home page and the club directory. #}
{% macro clubCard(c) -%}
<a href="{{ c.href }}" style="display: flex; align-items: center; gap: 14px; padding: 10px 14px 10px 10px; border: 1px solid #E1E7EC; border-radius: 14px; text-decoration: none; color: #221D35; min-height: 44px; background: #FFFFFF">
{{ logoTile(c) }}
<div style="display: flex; flex-direction: column; gap: 2px; min-width: 0">
<div style="font-weight: 700; font-size: 16px; line-height: 1.25">{{ c.name }}</div>
<div style="font-size: 14px; color: #626A70">{{ c.city }}</div>
</div>
</a>
{%- endmacro %}

{# One state's clubs, grouped by area. headingTag is h2 on the directory, h3 inside a state page section. #}
{% macro stateClubs(s, link=true, tag="h2") -%}
<div id="{{ s.id }}" style="display: flex; flex-direction: column; gap: 28px; scroll-margin-top: 24px">
<div style="display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 16px; border-bottom: 4px solid #F36D21; padding-bottom: 10px">
<{{ tag }} class="cond state-h" style="margin: 0; line-height: 0.9; color: #1E2427">{% if link %}<a href="/directory-category/{{ s.id }}/" style="color: inherit; text-decoration: none">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}</{{ tag }}>
<div style="font-size: 14px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #626A70">{{ s.count }} {{ "club" if s.count == 1 else "clubs" }}</div>
</div>
{% for ar in s.areas %}
<div style="display: flex; flex-direction: column; gap: 12px">
<div style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #283485">{{ pin() }}{{ ar.name }}</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px">
{% for c in ar.clubs %}{{ clubCard(c) }}
{% endfor %}
</div>
</div>
{% endfor %}
</div>
{%- endmacro %}
