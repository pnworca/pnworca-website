<footer id="contact" style="background: #1E2427; color: #CCD5DB">
<div style="max-width: 1240px; margin: 0 auto; padding: 40px 20px 32px; display: flex; flex-direction: column; gap: 40px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 32px">
<div style="display: flex; flex-direction: column; gap: 16px">
<img src="/assets/img/pnworca-logo-white.png" alt="PNWORCA, Pacific Northwest Outrigger Racing Canoe Association" style="width: 210px; height: auto; display: block">
<p style="margin: 0; font-size: 15px">The Pacific Northwest Outrigger Racing Canoe Association supports outrigger canoe clubs in Washington, Oregon, Montana, Idaho and Utah.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px; font-size: 15px">
<div style="font-weight: 700; color: #FDB714; text-transform: uppercase; letter-spacing: 0.16em; font-size: 13px">Paddle and race</div>
{% for n in home.mainNav %}<a href="{{ n.href }}" style="color: #CCD5DB; text-decoration: none">{{ n.label }}</a>
{% endfor %}</div>
<div style="display: flex; flex-direction: column; gap: 10px; font-size: 15px">
<div style="font-weight: 700; color: #FDB714; text-transform: uppercase; letter-spacing: 0.16em; font-size: 13px">Association</div>
{% for n in home.utilityNav %}<a href="{{ n.href }}" style="color: #CCD5DB; text-decoration: none">{{ n.label }}</a>
{% endfor %}</div>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid #3A4247; padding-top: 24px; font-size: 14px">
<div>© 2026 Pacific Northwest Outrigger Racing Canoe Association</div>
<div style="display: flex; gap: 20px">
<a href="#facebook" style="color: #FDB714">Facebook</a>
<a href="#contact" style="color: #FDB714">Email</a>
</div>
</div>
</div>
</footer>
