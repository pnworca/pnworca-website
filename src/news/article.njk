---
pagination:
  data: news
  size: 1
  alias: post
  addAllPagesToCollections: true
permalink: "/{{ post.slug }}/"
eleventyComputed:
  title: "{{ post.title }}"
  eyebrowText: "{{ post.date | dayLong }} · {{ post.category }}"
  description: "{{ post.excerpt or post.title }}"
---
<article class="prose longform news-body" style="font-size: 18px; max-width: 820px">
{% if post.image and not ("News-and-Announcements" in post.image or "BOD-Meetings-Image" in post.image or "Race-Results-Image" in post.image or "Message-Board-Image" in post.image) and not (post.image in post.html) %}<img src="{{ post.image }}" srcset="{{ post.image | srcset }}" sizes="(min-width: 900px) 820px, 100vw" width="{{ post.image | imgW }}" height="{{ post.image | imgH }}" fetchpriority="high" alt="{{ post.imageAlt }}" style="width: 100%; height: auto; border-radius: 12px; display: block; margin-bottom: 24px">{% endif %}
{{ post.html | safe }}
</article>
<p style="margin: 0"><a href="/news/" style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 14px">All news</a></p>
